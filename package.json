{
  "name": "fe-cli",
  "version": "1.0.0",
  "description": "现代化前端CLI工具，支持AI和TensorFlow.js",
  "main": "dist/src/core/cli.js",
  "bin": {
    "fe-cli": "./bin/fe-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/core/cli.ts",
    "start": "node dist/src/core/cli.js",
    "copy-templates": "ts-node scripts/copy-templates.ts",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "frontend",
    "template",
    "ai",
    "tensorflow",
    "scaffold"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "commander": "^9.4.1",
    "inquirer": "^8.2.5",
    "fs-extra": "^11.1.0",
    "handlebars": "^4.7.7",
    "chalk": "^4.1.2",
    "axios": "^1.3.4",
    "@tensorflow/tfjs": "^4.2.0",
    "@tensorflow/tfjs-node": "^4.2.0",
    "@tensorflow-models/mobilenet": "^2.1.0",
    "@tensorflow-models/coco-ssd": "^2.2.2",
    "@tensorflow-models/posenet": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^18.14.2",
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^8.2.1",
    "@types/handlebars": "^4.1.0",
    "@types/jest": "^29.4.0",
    "typescript": "^4.9.5",
    "ts-node": "^10.9.1",
    "jest": "^29.4.3",
    "ts-jest": "^29.0.5",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "eslint": "^8.34.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}