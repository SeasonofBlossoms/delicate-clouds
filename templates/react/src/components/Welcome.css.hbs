.welcome-content {
  margin-top: 2rem;
  text-align: left;
  max-width: 600px;
  margin: 2rem auto;
}

.welcome-steps, .welcome-scripts {
  text-align: left;
  line-height: 1.6;
  padding-left: 1.5rem;
}

.welcome-steps li, .welcome-scripts li {
  margin-bottom: 0.8rem;
}

.welcome-steps code, .welcome-scripts code {
  background: #f4f4f4;
  padding: 0.2rem 0.4rem;
  border-radius: 4px;
  font-family: 'Courier New', monospace;
  color: #d63384;
}

.project-info {
  margin: 2rem 0;
  padding: 1.5rem;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12px;
  color: white;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

.project-info h1 {
  margin: 0 0 1rem 0;
  font-size: 2.5em;
  font-weight: 700;
}

.project-meta {
  display: flex;
  justify-content: center;
  gap: 2rem;
  flex-wrap: wrap;
  margin-top: 1rem;
}

.meta-item {
  background: rgba(255, 255, 255, 0.1);
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.9em;
}